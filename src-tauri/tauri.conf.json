{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "EchoPlay",
  "version": "0.1.0",
  "identifier": "com.echoplay.desktop",
  "mainBinaryName": "EchoPlay",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "EchoPlay",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "hiddenTitle": true,
        "visible": false,
        "backgroundColor": "#F9F8F6"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/covers/**"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4RDBGQjE2NkREOTRERTQKUldUa1RkbHRGdnZRU0JINi8ybTl2SGg4UXg2b3BlSklRY3QyMFd4NUJOV0F0N2hKVU51WXNiQ0cK",
      "endpoints": [
        "https://github.com/zhliu33/echoplay/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libasound2"
        ]
      }
    }
  }
}